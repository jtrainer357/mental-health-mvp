# ===================================================
# Tebra Mental Health MVP - Environment Variables
# ===================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit your actual .env.local file to version control.

# -----------------
# Authentication
# -----------------
# Secret for NextAuth.js session encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-here

# Base URL for NextAuth.js (use http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000

# -----------------
# Supabase Configuration
# -----------------
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# Public URL for client-side access
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key for client-side access (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key for server-side operations (KEEP SECRET - never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------
# AI Providers
# -----------------
# Anthropic Claude API key (for AI features)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google AI (Gemini) API key (for data import and analysis)
GOOGLE_AI_API_KEY=your-google-ai-key-here

# OpenAI API key (optional fallback provider)
OPENAI_API_KEY=sk-your-openai-key-here

# -----------------
# Voice & Transcription
# -----------------
# Deepgram API key (for speech-to-text voice features)
DEEPGRAM_API_KEY=your-deepgram-key-here

# -----------------
# Optional / Development
# -----------------
# Node environment (development, production, test)
NODE_ENV=development

# Enable debug logging
DEBUG=false
